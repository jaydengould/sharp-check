# Copy to .env (gitignored) and fill in. Read-only use: no order endpoints are ever called.

# Kalshi API key ID, and its RSA private key as base64 of the DER bytes (not PEM).
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY=

# Polymarket US API key ID, and its Ed25519 secret key as base64 (the first 32 bytes are the private key).
POLYMARKET_US_KEY_ID=
POLYMARKET_US_SECRET_KEY=